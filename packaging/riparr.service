[Unit]
Description=Riparr — disc ripping appliance
Documentation=https://github.com/jackharvest/riparr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=riparr
Group=riparr
# The optical drive is owned by root:cdrom, and the service has to read it.
SupplementaryGroups=cdrom
WorkingDirectory=/opt/riparr/server

# The default port, overridden by whatever the preparer wrote to the boot partition.
# Later assignments win, so the file beats this line when it exists.
Environment=RIPARR_PORT=9797
Environment=RIPARR_DB=/var/lib/riparr/riparr.db
Environment=PYTHONUNBUFFERED=1
# The service account may be the login account the Imager created, whose home is under
# /home — which ProtectHome= hides. Point HOME at the state directory instead, so
# ~/.MakeMKV resolves somewhere that exists and is writable.
Environment=HOME=/var/lib/riparr
EnvironmentFile=-/boot/firmware/riparr.conf
EnvironmentFile=-/boot/riparr.conf

ExecStart=/opt/riparr/.venv/bin/python -m uvicorn riparr.main:app \
          --host 0.0.0.0 --port ${RIPARR_PORT}

# The cable gets pulled and discs misbehave; staying up is the whole job (D4).
Restart=always
RestartSec=3

# Modest hardening. Deliberately not sandboxed to death: the service needs the optical
# drive, the staging partition, and the ability to mount a network share.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
# The leading '-' matters: on stock Raspberry Pi OS the dedicated staging partition (D4)
# does not exist yet, and systemd refuses to start a unit whose ReadWritePaths= names a
# missing directory. Without it, first boot ends with a service that never starts.
ReadWritePaths=/var/lib/riparr -/srv/staging
StateDirectory=riparr

[Install]
WantedBy=multi-user.target
