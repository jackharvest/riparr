[Unit]
Description=Watch for a Riparr request to Restart the box
Documentation=https://github.com/jackharvest/riparr

[Path]
# The web service is unprivileged and cannot call systemctl reboot. It can create one
# file in its own runtime directory, and that is the whole interface. There is nothing
# in the file to parse and nothing for the root side to trust: the action is fixed by
# which path unit fired, so a compromised service can ask for exactly reboot and
# nothing else.
PathExists=/run/riparr/reboot.request

[Install]
WantedBy=multi-user.target
