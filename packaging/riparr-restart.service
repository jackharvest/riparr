[Unit]
Description=Restart Riparr on request
Documentation=https://github.com/jackharvest/riparr

[Service]
Type=oneshot
ExecStartPre=/bin/rm -f /run/riparr/restart.request
# A moment's grace so the HTTP response that asked for this is finished and sent. The
# request is answered by the process about to be killed, and a browser that gets a
# dropped connection instead of "updated" cannot tell success from failure.
ExecStart=/bin/sh -c 'sleep 2; exec systemctl restart riparr.service'
